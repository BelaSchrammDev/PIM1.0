<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The script itself is limited to C# 6 by the in-game compiler.
         The test assembly is not, and C# 6 sources compile fine here. -->
    <LangVersion>latest</LangVersion>
    <RootNamespace>IngameScript.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Separate from PIM1.0.Tests: SMS and PIM both declare "partial class Program" with
       members of the same name (e.g. ToArgStr), so they cannot be linked into one assembly.
       Link only pure SMS files here (no Sandbox.ModAPI, VRage or MyGridProgram). -->
  <ItemGroup>
    <Compile Include="..\SMS1\Definitions\ItemDataParser.cs" Link="Linked\ItemDataParser.cs" />
    <Compile Include="..\SMS1\Definitions\ItemNames.cs" Link="Linked\ItemNames.cs" />
    <Compile Include="..\SMS1\Definitions\Generated\ItemData.g.cs" Link="Linked\ItemData.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- generator: test that the committed ItemData.g.cs matches ItemData/*.txt, error messages -->
  <ItemGroup>
    <ProjectReference Include="..\SMS1.ItemDataGenerator\SMS1.ItemDataGenerator.csproj" />
    <!-- tool: the .sbc reader with fake game data -->
    <ProjectReference Include="..\SMS1.ItemDataTool\SMS1.ItemDataTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>

</Project>
